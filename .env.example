# AdGuard Home Configuration
# Full URL to your AdGuard Home instance (include protocol and port)
ADGUARD_URL=http://192.168.1.100:3000

# AdGuard Home admin credentials
ADGUARD_USER=admin
ADGUARD_PASS=yourpassword

# PowerDNS API Key
# This is the key that Proxmox will use to authenticate with the shim
# Generate a secure key with: openssl rand -hex 32
POWERDNS_API_KEY=your-secret-api-key-here

# Optional: Number of Gunicorn workers (default: 4)
GUNICORN_WORKERS=4

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
